# Django Security Settings
# These are read from the environment (there is no dotenv loader),
# so export them in your shell before starting the server:
#
#   export DJANGO_SECRET_KEY=...
#   export DJANGO_DEBUG=True
#   export DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#   python3 manage.py runserver 0.0.0.0:8000
#
# All values below are OPTIONAL for local development — settings.py
# falls back to safe defaults when they are not set.

# Secret key for Django (generate a new one for production)
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode (True for development, False for production)
DJANGO_DEBUG=True

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
